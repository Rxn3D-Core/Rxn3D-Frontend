# Production / default
NEXT_PUBLIC_API_BASE_URL = "https://api.rxn3d.com/v1"
# Public frontend origin for Open Graph / social preview absolute URLs
NEXT_PUBLIC_SITE_URL=https://app.rxn3d.com

# Optional: local Laravel on another port (e.g. 8080). Avoids browser CORS from :3000 -> :8080 —
# fetch goes to Next (same origin), Next rewrites to Laravel. Uncomment both lines below and restart `next dev`.
# NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api-proxy/v1
# API_PROXY_BACKEND_URL=http://localhost:8080

NODE_ENV=production
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=